Import("env")

wrapped_fn_list = [

    # Implémentations requises par le firmware

    "fflush",
    "printf",
    "putc",  # Fallback printf généré par GCC
    "putchar",
    "puts",  # Fallback printf généré par GCC
    "snprintf",
    "vsnprintf",  # m-string
    "__assert",
    "__assert_func",

    # Wrappers empêchant appels non supportés


    "setbuf",
    "setvbuf",
    "fprintf",
    "vfprintf",
    "vprintf",
    "fputc",
    "fputs",
    "sprintf",  # Fonction dangereuse volontairement non implémentée
    "asprintf",
    "vasprintf",
    "asiprintf",
    "asniprintf",
    "asnprintf",
    "diprintf",
    "fiprintf",
    "iprintf",
    "siprintf",
    "sniprintf",
    "vasiprintf",
    "vasniprintf",
    "vasnprintf",
    "vdiprintf",
    "vfiprintf",
    "viprintf",
    "vsiprintf",
    "vsniprintf",



    "fgetc",
    "getc",
    "getchar",
    "fgets",
    "ungetc",

    # Entrée standard non implémentée

    "gets",

    # scanf non implémenté

































]

for wrapped_fn in wrapped_fn_list:
    env.Append(
        LINKFLAGS=[
            "-Wl,--wrap," + wrapped_fn,
            "-Wl,--wrap," + wrapped_fn + "_unlocked",
            "-Wl,--wrap,_" + wrapped_fn + "_r",
            "-Wl,--wrap,_" + wrapped_fn + "_unlocked_r",
        ]
    )

env.Append(
    SDK_HEADERS=[
        File("wrappers.h"),
    ],
    LINT_SOURCES=[
        Dir("."),
    ],
)

libenv = env.Clone(FW_LIB_NAME="print")
libenv.ApplyLibFlags()
if env["RAM_EXEC"]:
    libenv.AppendUnique(CPPDEFINES=["PRINTF_DISABLE_SUPPORT_FLOAT"])

libenv.Append(CCFLAGS=["-Wno-double-promotion"])

sources = libenv.GlobRecursive("*.c*", ".")

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")

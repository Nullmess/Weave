Import("env")

env.Append(
    CPPPATH=[

        "#/lib/mbedtls/include",
    ],
    SDK_HEADERS=[
        File("mbedtls/include/mbedtls/aes.h"),
        File("mbedtls/include/mbedtls/des.h"),
        File("mbedtls/include/mbedtls/sha1.h"),
        File("mbedtls/include/mbedtls/sha256.h"),
        File("mbedtls/include/mbedtls/md5.h"),
        File("mbedtls/include/mbedtls/md.h"),
        File("mbedtls/include/mbedtls/ecdsa.h"),
        File("mbedtls/include/mbedtls/ecdh.h"),
        File("mbedtls/include/mbedtls/ecp.h"),

    ],
    CPPDEFINES=[("MBEDTLS_CONFIG_FILE", '\\"mbedtls_cfg.h\\"')],
)


libenv = env.Clone(FW_LIB_NAME="mbedtls")
libenv.ApplyLibFlags()

# Compact main firmware only; keep ordinary object code available for non-LTO users.
if env["IS_BASE_FIRMWARE"] and env["COMPACT"]:
    libenv.AppendUnique(CCFLAGS=["-flto", "-ffat-lto-objects"])
    libenv.Replace(
        AR=libenv.subst("${TOOLCHAIN_PREFIX}gcc-ar"),
        RANLIB=libenv.subst("${TOOLCHAIN_PREFIX}gcc-ranlib"),
        # GCC 12 gcc-ar treats a leading @response-file as an operation.
        # Pass the operation, archive and object paths directly for LTO archives.
        ARCOM="$AR $ARFLAGS $TARGET $SOURCES",
    )


libenv.AppendUnique(
    CCFLAGS=[
        # Nécessaire au linkage des FAP
        "-mword-relocations",
        "-mlong-calls",

        "-Wno-redundant-decls",
    ],
)




sources = [
    File("mbedtls/library/aes.c"),
    File("mbedtls/library/gcm.c"),
    File("mbedtls/library/sha512.c"),
    File("mbedtls/library/ecdh.c"),
    File("mbedtls/library/rsa.c"),
    File("mbedtls/library/rsa_alt_helpers.c"),
    File("mbedtls/library/oid.c"),
    File("mbedtls/library/asn1parse.c"),
    File("mbedtls/library/asn1write.c"),
    File("mbedtls/library/cipher.c"),
    File("mbedtls/library/cipher_wrap.c"),
    File("mbedtls/library/constant_time.c"),
    File("mbedtls/library/bignum.c"),
    File("mbedtls/library/bignum_core.c"),
    File("mbedtls/library/ecdsa.c"),
    File("mbedtls/library/ecp.c"),
    File("mbedtls/library/ecp_curves.c"),
    File("mbedtls/library/md.c"),
    File("mbedtls/library/md5.c"),
    File("mbedtls/library/platform_util.c"),
    File("mbedtls/library/ripemd160.c"),
    File("mbedtls/library/sha1.c"),
    File("mbedtls/library/sha256.c"),
    File("mbedtls/library/des.c"),
]
Depends(sources, File("mbedtls_cfg.h"))


lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")

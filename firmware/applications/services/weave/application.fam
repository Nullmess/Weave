App(
    appid="weave",
    name="Weave",
    apptype=FlipperAppType.STARTUP,
    entry_point="weave_on_system_start",
    requires=["cli", "storage"],
    order=95,
    cdefines=["SRV_WEAVE"],
    sdk_headers=["weave.h", "weave_usb.h", "weave_security.h", "weave_permissions.h", "weave_platform.h", "weave_keystore.h", "weave_ble.h", "weave_nfc.h"],
)

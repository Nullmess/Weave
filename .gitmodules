[submodule "firmware/lib/mlib"]
	path = firmware/lib/mlib
	url = https://github.com/P-p-H-d/mlib.git
[submodule "firmware/lib/nanopb"]
	path = firmware/lib/nanopb
	url = https://github.com/nanopb/nanopb.git
[submodule "firmware/assets/protobuf"]
	path = firmware/assets/protobuf
	url = https://github.com/flipperdevices/flipperzero-protobuf.git
	shallow = false
[submodule "firmware/lib/libusb_stm32"]
	path = firmware/lib/libusb_stm32
	url = https://github.com/flipperdevices/libusb_stm32.git
[submodule "firmware/lib/FreeRTOS-Kernel"]
	path = firmware/lib/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "firmware/lib/microtar"]
	path = firmware/lib/microtar
	url = https://github.com/amachronic/microtar.git
[submodule "firmware/lib/mbedtls"]
	path = firmware/lib/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "firmware/lib/heatshrink"]
	path = firmware/lib/heatshrink
	url = https://github.com/flipperdevices/heatshrink.git
[submodule "firmware/lib/st_cmsis_device_wb"]
	path = firmware/lib/stm32wb_cmsis
	url = https://github.com/STMicroelectronics/cmsis_device_wb
[submodule "firmware/lib/stm32wbxx_hal_driver"]
	path = firmware/lib/stm32wb_hal
	url = https://github.com/STMicroelectronics/stm32wbxx_hal_driver
[submodule "firmware/lib/stm32wb_copro"]
	path = firmware/lib/stm32wb_copro
	url = https://github.com/flipperdevices/stm32wb_copro.git
